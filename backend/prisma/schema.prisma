generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id               String   @id @default(cuid())
  provider         String
  providerIntentId String   @index
  status           String   @index
  orderId          String   @index
  buyerId          String   @index
  amount           Int
  currency         String
  clientKey        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([provider, providerIntentId])
  @@index([orderId, createdAt])
  @@index([buyerId, createdAt])
}
