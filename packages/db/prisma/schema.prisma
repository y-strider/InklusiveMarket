/* Set-Content -Path packages/db/prisma/schema.prisma update prisma schema for payments model */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      String
  paymentsB Payment[] @relation("BuyerPayments")
  paymentsS Payment[] @relation("SellerPayments")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id                String   @id @default(cuid())
  reference         String   @unique
  amount            Int
  currency          String   @default("PHP")
  status            String   @default("pending")
  buyerId           String?
  sellerId          String?
  buyer             User?    @relation("BuyerPayments", fields: [buyerId], references: [id])
  seller            User?    @relation("SellerPayments", fields: [sellerId], references: [id])
  provider          String   @default("paymongo")
  providerPaymentId String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([createdAt])
}
