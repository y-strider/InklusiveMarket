{
  "name": "SellerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "profile_image_url": {
      "type": "string"
    },
    "banner_image_url": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "pwd_classification": {
      "type": "string",
      "description": "Type of PWD classification"
    },
    "avrc_member_id": {
      "type": "string"
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "admin_notes": {
      "type": "string"
