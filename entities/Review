{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "hidden"
      ],
      "default": "approved"
    },
    "seller_response": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "order_id",
    "buyer_id",
    "rating"
  ]
}