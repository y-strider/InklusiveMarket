{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "description": {
      "type": "string",
      "description": "Category description"
    },
    "image_url": {
      "type": "string",
      "description": "Category image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category ID for nesting"
    }
  },
  "required": [
    "name"
  ]
}